# Vorlage: kopiere diese Datei nach .env und trage deine Werte ein.
# .env steht in .gitignore und landet nie auf GitHub.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-hier-eintragen
CLAUDE_MODEL=claude-sonnet-5-5

# --- PostgreSQL (gelesen von docker-compose UND von der App) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Monitoring ---
# Geheimer Zufallswert für die Prüfsumme der Fragen im Protokoll (Fragen werden nie im Klartext
# gespeichert). Ohne geheimen Wert liessen sich häufige Fragen durch Ausprobieren erraten.
# Erzeugen z.B. mit:  python -c "import secrets; print(secrets.token_hex(16))"
PROTOKOLL_SALT=bitte-zufaelligen-wert-setzen
